# CALLMEBOT_API_KEY_2=""

# UltraMsg Gateway (Optional)
# ULTRAMSG_INSTANCE_ID=""
# ULTRAMSG_TOKEN=""

# Meta WhatsApp Cloud API (Optional)
# META_WHATSAPP_TOKEN=""
# META_PHONE_NUMBER_ID=""
